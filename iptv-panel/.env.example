# Required for admin login
ADMIN_PASSWORD=changeme

# iron-session cookie encryption (min 32 characters)
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Optional: public base URL used when displaying playlist links in the UI
# PUBLIC_BASE_URL=http://localhost:3000

# Optional: require ?token= on device playlist endpoints
# REQUIRE_PLAYLIST_TOKEN=1

# Daily refresh cron (node-cron). Default: 04:00 every day.
# CRON_SCHEDULE=0 4 * * *

# Disable in-process cron (use external scheduler against /api/cron/refresh instead)
# DISABLE_CRON=1

# Protect external cron endpoint when set
# CRON_SECRET=another-long-random-secret

# Optional SQLite path override
# DATABASE_PATH=./data/iptv.sqlite
# DATA_DIR=./data
