{
  "name": "local-sol-trader",
  "version": "1.0.0",
  "private": true,
  "description": "Personal local-only Solana meme trader. Private key stays in .env on your machine.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build:web": "vite build",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/node": "^22.17.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^6.3.5"
  }
}