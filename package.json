{
  "name": "offlinerich",
  "version": "1.0.0",
  "private": true,
  "description": "USD card funded by ERC-20 tokens, with Apple Pay, Google Pay, and Samsung Pay.",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/index.ts",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test test/*.ts",
    "typecheck": "tsc --noEmit",
    "build:wallet": "npx --yes esbuild src/gg-wallet.ts --bundle --format=iife --outfile=public/gg-wallet.js --platform=browser",
    "phone:tunnel": "bash scripts/phone-tunnel.sh",
    "publish:live": "bash scripts/publish-live-site.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/offrich666/OFFLINERICH.git"
  },
  "license": "ISC",
  "dependencies": {
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "viem": "^2.37.9"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.3",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.9.2"
  }
}
