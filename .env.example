# Deployer key. This account pays gas. Never commit a real key.
PRIVATE_KEY=

# Wallet that receives the minted tokens and becomes the contract owner.
RECIPIENT=

# Wei amount minted in the constructor. Omit to mint the full 1,000,000,000 RICH cap.
# 1 RICH = 1000000000000000000 (18 decimals).
INITIAL_SUPPLY=

# Used by script/Mint.s.sol after the token is already deployed.
TOKEN=
MINT_AMOUNT=
