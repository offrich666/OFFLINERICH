# Local: http://localhost:3000  ·  Production: https://www.walletchainsign.com
NEXT_PUBLIC_APP_URL=https://www.walletchainsign.com

# Crossmint — https://www.crossmint.com/console
# Server key needs scopes: orders.create, orders.read (+ wallets.create for email wallets)
CROSSMINT_SERVER_API_KEY=sk_production_...
# Aliases also accepted: CROSSMINT_SECRET_API_KEY, CROSSMINT_SERVER_SIDE_API_KEY
NEXT_PUBLIC_CROSSMINT_API_KEY=ck_production_...
# Aliases also accepted: NEXT_PUBLIC_CLIENT_API_KEY, NEXT_PUBLIC_CROSSMINT_CLIENT_SIDE_API_KEY
NEXT_PUBLIC_CROSSMINT_ENV=production
NEXT_PUBLIC_ONRAMP_DEFAULT_AMOUNT=20
NEXT_PUBLIC_ONRAMP_DEFAULT_CHAIN=polygon
# NEXT_PUBLIC_CROSSMINT_COLLECTION_ID=offlinerich-drop
# CROSSMINT_PAYOUT_ADDRESS=0x...

# Stripe LIVE — G N LABS LLC (acct_1UCk64QWCzdANStk) — Onramp APPROVED
