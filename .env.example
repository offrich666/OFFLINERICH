# Client key (browser). Whitelist localhost + your HTTPS domain in Crossmint Console.
NEXT_PUBLIC_CROSSMINT_API_KEY=ck_production_...

# Server key (NEVER expose to the browser). Needs orders.create + wallets.create (+ orders.read).
CROSSMINT_SERVER_API_KEY=sk_production_...

# production | staging  (auto-detected from key prefix if omitted)
NEXT_PUBLIC_CROSSMINT_ENV=production

# Optional overrides (defaults follow NEXT_PUBLIC_CROSSMINT_ENV)
# CROSSMINT_API_BASE=https://www.crossmint.com/api/2022-06-09
# CROSSMINT_WALLETS_API_BASE=https://www.crossmint.com/api/2025-06-09

# Onramp defaults
NEXT_PUBLIC_ONRAMP_DEFAULT_AMOUNT=20
NEXT_PUBLIC_ONRAMP_DEFAULT_CHAIN=polygon

# Apple Pay domain association file contents from Crossmint Console → Apple Pay Domains
# APPLE_PAY_DOMAIN_ASSOCIATION=...

# Paid drop collection (default offlinerich-drop)
NEXT_PUBLIC_CROSSMINT_COLLECTION_ID=offlinerich-drop
NEXT_PUBLIC_CROSSMINT_PRICE=1

# Payout wallet (naserademid@gmail.com Crossmint smart wallet)
CROSSMINT_PAYOUT_ADDRESS=0x2A787A5D845Ac9636De5E4Ab599fBB65A7B08443
CROSSMINT_WALLET_OWNER_EMAIL=naserademid@gmail.com

# Business/contact email for Crossmint Sales / verification
CROSSMINT_CONTACT_EMAIL=groupgrow64@gmail.com
