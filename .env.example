PORT=8787
# Local cardholder database. Contains name, phone, and date of birth.
DATABASE_PATH=./data/offlinerich.sqlite

# Live Immersve card issuing. Test keys (imm-key-test- / imm-secret-test-) are refused.
# Ask Immersve for the live partner account. The same values can be pasted in the dashboard.
IMMERSVE_API_KEY=
IMMERSVE_API_SECRET=
IMMERSVE_PARTNER_ACCOUNT_ID=
IMMERSVE_CLIENT_APPLICATION_ID=
IMMERSVE_CARD_PROGRAM_ID=
IMMERSVE_FUNDING_CHANNEL_ID=
# Universal EVM Funds Storage (deposit target). From createFundsStorage / FundsStorageCreated.
IMMERSVE_FUNDS_STORAGE_ADDRESS=
# e.g. base-mainnet-usdc-universal-evm
IMMERSVE_FUNDING_TYPE_NAME=
IMMERSVE_CLIENT_ORIGIN=https://your.domain
IMMERSVE_NETWORK=base-mainnet

# Wallet that receives ERC-20 top-ups. This server never sees the private key.
# Optional extra deposit address. After the card is issued, Immersve's deposit
# contract is the address that funds the card.
TREASURY_ADDRESS=

# Optional per-chain RPC overrides. Public RPCs are the default.
# RPC_URL_1=https://ethereum.publicnode.com
# RPC_URL_8453=https://mainnet.base.org

# Fee taken when a deposit is converted into card balance. 100 = 1%.
TOPUP_FEE_BPS=100
MIN_TOPUP_CENTS=100
MAX_TOPUP_CENTS=5000000

# Comma-separated merchant countries to decline. Empty means worldwide.
BLOCKED_MERCHANT_COUNTRIES=

# Visa In-App Provisioning for Samsung Pay push. Manual Samsung Pay does not need these.
VISA_API_KEY=
VISA_SHARED_SECRET=
VISA_API_BASE=https://sandbox.api.visa.com
# Visa's sandbox often also requires a client certificate.
# VISA_CERT_PATH=
# VISA_KEY_PATH=

# First 6 or 8 digits of the BIN, sent as Samsung EXTRA_ISSUER_ID when a network requires it.
# CARD_BIN=

# Protects POST /api/operator/cards/:id/vcard
OPERATOR_TOKEN=

SECURE_COOKIES=false
TRUST_PROXY=false


# Pay2.House — issue virtual cards today (https://pay2.house/keys/prepare)
PAY2_API_KEY=
PAY2_KEY_ID=
PAY2_PRIVATE_KEY_PEM=
PAY2_ACCOUNT_NUMBER=
PAY2_BIN_NUMBER=

# Public G Cards EU 31.2.7 dedicated-server package ($1,300). Paid in USDC directly (not card-spend tokens).
UPGRADE_PRICE_USD=1300
UPGRADE_USDC_ADDRESS=
# Legacy alias still accepted:
# UPGRADE_USDT_ADDRESS=

