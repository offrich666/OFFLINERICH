# Client key (safe for browser). Whitelist localhost + your domain in Crossmint Console.
NEXT_PUBLIC_CROSSMINT_API_KEY=ck_production_...

# Server key (NEVER expose to the browser). Used only by /api/* routes.
CROSSMINT_SERVER_API_KEY=sk_production_...

# Collection that has Sell/Payments enabled in Crossmint Console.
NEXT_PUBLIC_CROSSMINT_COLLECTION_ID=

# Checkout price shown in the embedded widget (must match collection pricing).
NEXT_PUBLIC_CROSSMINT_PRICE=1

# Production API base (change to https://staging.crossmint.com/api/2022-06-09 for staging keys).
CROSSMINT_API_BASE=https://www.crossmint.com/api/2022-06-09

# Optional: wallet that receives sale proceeds (used by npm run setup:collection).
CROSSMINT_PAYOUT_ADDRESS=
