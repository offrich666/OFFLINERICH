# Local: http://localhost:3000  ·  Production: https://www.walletchainsign.com
NEXT_PUBLIC_APP_URL=https://www.walletchainsign.com

# Stripe LIVE — Crypto Onramp (primary checkout: card on-page → crypto to client wallet)
# https://dashboard.stripe.com/apikeys
# https://dashboard.stripe.com/crypto-onramp/get-started
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PRICE_ID=price_1UVgRDQWCzdANStksBqKZ5BL
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_URL=https://buy.stripe.com/aFafZj4TvdLq8WAboDds408
STRIPE_WEBHOOK_SECRET=whsec_...

# Instant on-page (thirdweb buy-widget — card only → USDC to client wallet)
# https://thirdweb.com/dashboard — allowlist www.walletchainsign.com
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=
THIRDWEB_SECRET_KEY=

# Transak (legacy / optional)
# Staging keys: https://dashboard.transak.com
TRANSAK_API_KEY=
TRANSAK_API_SECRET=
TRANSAK_ENVIRONMENT=STAGING

# Crossmint Instant (production needs Sales/KYB; staging self-serve)
# https://www.crossmint.com/console
CROSSMINT_SERVER_API_KEY=sk_production_...
NEXT_PUBLIC_CROSSMINT_API_KEY=ck_production_...
NEXT_PUBLIC_CROSSMINT_ENV=production
NEXT_PUBLIC_ONRAMP_DEFAULT_CHAIN=polygon
NEXT_PUBLIC_ONRAMP_DEFAULT_AMOUNT=20
# Optional: paste Crossmint Apple Pay association file contents
# APPLE_PAY_DOMAIN_ASSOCIATION=

# Ops queue for treasury → client sends (/ops/transfers?key=...)
OPS_SECRET=change-me
