# Local-only. Never commit real keys. Never paste keys into websites.
PRIVATE_KEY=
# Bulk wallets: one base58 secret per line (or JSON array). Local disk only.
WALLETS_FILE=./wallets.txt
RPC_URL=https://api.mainnet-beta.solana.com
# Optional per-chain RPC overrides for the CLI sniper:
# RPC_URL_SOLANA=
# RPC_URL_BASE=
# RPC_URL_BSC=
# RPC_URL_ETHEREUM=
# RPC_URL_ARBITRUM=
# RPC_URL_POLYGON=
# RPC_URL_OPTIMISM=
# RPC_URL_AVALANCHE=
# Keep true until you intentionally enable live trades
DRY_RUN=true
# Max SOL per buy per wallet (hard cap)
MAX_BUY_SOL=0.1
# Hard cap on how many keys a wallets file may contain
MAX_WALLETS=500
# Faster burst sends (skip simulation). Slightly higher fail risk.
SKIP_PREFLIGHT=true
PORT=3847
# 0.0.0.0 = reachable from your phone on the same Wi‑Fi
HOST=0.0.0.0
# Optional. If empty and HOST is not localhost, a token is auto-generated.
# Open the printed Phone URL that includes ?access=…
ACCESS_TOKEN=